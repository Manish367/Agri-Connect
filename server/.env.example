# Copy this file to .env and fill in real values as you get them.
# The app runs with sane defaults/mocks if you leave these blank.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Optional: live weather. Without this, /api/weather returns labeled mock data.
OPENWEATHER_API_KEY=

# Optional: cloud image storage. Without this, uploads are stored locally in /uploads.
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
